# ── Communication plugins: how you reach Wren, and how Wren reaches you ─────
# Comma-separated. Wren starts only what's listed here. Each is either a
# "chat" plugin (input + output, e.g. discord/http) or an "input"-only event
# watcher (e.g. gmail/github) that never talks back directly — it notifies
# through whichever chat plugin NOTIFY_VIA points at.
#   discord — DM the bot (needs DISCORD_TOKEN)              [chat]
#   telegram — DM the bot on Telegram (needs TELEGRAM_TOKEN)        [chat]
#   http    — local HTTP API + browser chat UI (needs WREN_TOKENS)  [chat]
#   gmail   — IMAP inbox watcher (needs IMAP_* + EMAIL_WATCH below) [input]
#   github  — repo activity watcher (needs GITHUB_WATCH below)      [input]
COMMUNICATION_PLUGINS=discord

# Where unprompted messages go — reminders firing, gmail/github watcher alerts.
# Replies always go back to whichever chat plugin asked. Defaults to the
# first entry in COMMUNICATION_PLUGINS. The http plugin is send-only and
# cannot receive these; input-only plugins (gmail/github) can't either.
# NOTIFY_VIA=discord

# Your Wren user id, and NOT a setting of any one chat plugin. Every note,
# reminder and pin is filed under it, so changing it later orphans everything
# you have saved -- pick it once and leave it. Any integer works; the usual
# move is to reuse the user id of whichever chat plugin you set up first.
# To reach Wren from a SECOND chat plugin, do not change this: map that
# plugin's id onto it (TELEGRAM_OWNER_ID below does exactly that).
WREN_OWNER_ID=111111111111111111

# Required only when COMMUNICATION_PLUGINS includes 'discord'. Wren runs without it.
DISCORD_TOKEN=your_bot_token_here

# Shown in the web chat's greeting ("Good evening, Erin"). Also settable from
# the plugins panel. Unset means the greeting is just the time of day.
# OWNER_NAME=Erin

# ── Telegram communication plugin (only when COMMUNICATION_PLUGINS includes 'telegram') ──
# Talk to @BotFather, /newbot, paste the token it hands you here, then add
# 'telegram' to COMMUNICATION_PLUGINS above. Wren answers direct messages only
# and ignores groups. Nothing else to configure — it long-polls, so the bot
# needs no public URL and no webhook.
#
# TELEGRAM_TOKEN=123456789:AAExample-token-from-botfather
#
# Your Telegram user id (ask @userinfobot). Wren ignores anyone it doesn't
# recognise, and the number Telegram calls you is NOT the number Discord calls
# you — so on an install that already has another chat plugin, set this and
# Telegram becomes a second door into the same Wren: same notes, same
# reminders, same owner rights. Leave it unset only on a Telegram-only install,
# where WREN_OWNER_ID above is already the Telegram id.
#
# Anyone else on Telegram is a plain contact ("add 123456789 as phone") with
# their own notes, as on any other surface.
# TELEGRAM_OWNER_ID=123456789

# ── HTTP communication plugin (only when COMMUNICATION_PLUGINS includes 'http') ──
# Serves both the machine API (used by the voice client) and the browser chat
# UI at http://<host>:8787/ — open it and paste one of these tokens once.
# Maps a bearer token to a Wren user id. Generate with:  openssl rand -hex 24
# WREN_TOKENS=paste_a_long_random_token_here:111111111111111111
#
# 127.0.0.1 keeps it on this machine, and is the recommended setting. Wren
# speaks plain HTTP with no TLS, so 0.0.0.0 puts the bearer token on the wire
# in clear text for anything on the network to read. To reach it from other
# machines, leave this at 127.0.0.1 and put a TLS reverse proxy in front —
# see the README's Communication plugins section for a worked nginx block.
# Bind that proxy to your LAN address, not 0.0.0.0: a host with a public IPv6
# address is internet-reachable on every interface it listens on.
# WREN_HTTP_HOST=127.0.0.1
# WREN_HTTP_PORT=8787

# ── Voice (optional) ─────────────────────────────────────────────────────────
# Speech-to-text runs on THIS machine; audio never leaves your network.
# Needs: pip install faster-whisper       (without it, /voice returns 503)
# Models, smallest first: tiny.en, base.en, small.en, medium.en, large-v3
# WREN_STT_MODEL=base.en
# WREN_STT_DEVICE=auto      # auto | cpu | cuda
# WREN_STT_COMPUTE=int8     # int8 for CPU; float16 pairs well with cuda

# ── Storage ──────────────────────────────────────────────────────────────────
# Absolute path recommended — a relative one resolves against the working
# directory, so systemd and a shell can otherwise end up on different databases.
# WREN_DB=/home/you/wren/wren.db

# Comma-separated priority order. Wren tries each in order until one succeeds.
# Available: lmstudio, ollama, openai, claude, openrouter
LLM_PROVIDERS=lmstudio

LMSTUDIO_BASE_URL=http://192.168.1.10:1234/v1
LMSTUDIO_MODEL=gemma4-e4b-131k:latest

# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3

# Gmail/IMAP-arrival watcher (optional — leave EMAIL_WATCH unset to disable,
# or drop 'gmail' from COMMUNICATION_PLUGINS)
# IMAP_HOST=imap.example.com
# IMAP_USER=you@example.com
# IMAP_PASSWORD=app-password
# EMAIL_POLL_SECONDS=60
# EMAIL_WATCH=alice@example.com:owner,bob@example.com:husband

# GitHub repo activity watcher (optional — leave GITHUB_WATCH unset to disable,
# or drop 'github' from COMMUNICATION_PLUGINS)
# GITHUB_TOKEN=ghp_...                  # optional; required for private repos, raises rate limit to 5000/hr
# GITHUB_WATCH=owner/repo,owner/repo2   # comma-separated owner/repo list
# GITHUB_POLL_SECONDS=60

# Reminder poll interval (optional — default 30 seconds)
# REMINDER_POLL_SECONDS=30

# Timezone for reminder scheduling and display (optional — default UTC)
# Use an IANA timezone name, e.g. America/Chicago, America/New_York, Europe/London
# TIMEZONE=America/Chicago

# Web lookup (optional — leave SEARXNG_URL unset to disable)
# SEARXNG_URL=http://searxng.lan/searxng/
# FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=          # only if your Firecrawl container requires auth
#
# NOTE: Wren calls SearXNG's JSON API. Your SearXNG must allow it, or every
# search returns "Search is unavailable right now." In settings.yml:
#   search:
#     formats: [html, json]   # 'json' is NOT enabled by default
# and its bot limiter will 429 non-browser callers — on a private LAN set
#   server:
#     limiter: false
